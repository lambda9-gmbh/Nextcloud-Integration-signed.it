{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "openapi": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/openapi-mcp.sh"]
    },
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y", "@modelcontextprotocol/server-postgres",
        "postgres://nextcloud:nextcloud@localhost:5433/nextcloud"
      ]
    }
  }
}
